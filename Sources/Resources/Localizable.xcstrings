    "%@ is protected by the system and cannot be terminated.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è protetto dal sistema e non può essere terminato."
          }
        }
      }
    },
    "%@ belongs to another user. Terminating it needs administrator privileges.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ appartiene a un altro utente. Servono privilegi di amministratore."
          }
        }
      }
    },
    "Sirocco won't terminate itself. Use Quit.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirocco non termina se stesso. Usa Esci."
          }
        }
      }
    },
    "Permission denied by macOS (EPERM). %@ is protected.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permesso negato da macOS (EPERM). %@ è protetto."
